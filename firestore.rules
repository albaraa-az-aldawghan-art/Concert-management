rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال مساعدة ────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function role() {
      return userData().role;
    }

    function isAdmin()            { return signedIn() && role() == 'admin'; }
    function isWarehouse()        { return signedIn() && role() == 'warehouse_manager'; }
    function isSupervisor()       { return signedIn() && role() == 'supervisor'; }
    function isEmployee()         { return signedIn() && role() == 'employee'; }
    function isKitchen()          { return signedIn() && role() == 'kitchen'; }
    function isAdminOrWarehouse() { return signedIn() && role() in ['admin', 'warehouse_manager']; }

    // ── الأدوار المخصصة (صلاحيات على مستوى الميزات) ───────────
    function isCustom() { return signedIn() && role() == 'custom'; }

    function customPerms() {
      return get(/databases/$(database)/documents/custom_roles/$(userData().customRoleId)).data.permissions;
    }

    // الصفحة مفعّلة (عرض على الأقل)
    function pageOn(page) {
      return isCustom() && page in customPerms();
    }

    // يملك ميزة محددة داخل الصفحة — يدعم الصيغة القديمة 'manage'
    function hasFeat(page, feature) {
      return isCustom() && page in customPerms() && (
        customPerms()[page] is list
          ? feature in customPerms()[page]
          : customPerms()[page] == 'manage'
      );
    }

    // ── المستخدمون ─────────────────────────────────────────────
    match /users/{userId} {
      allow get:    if signedIn() && (uid() == userId || isAdmin() || pageOn('users') || pageOn('concerts') || pageOn('supervisor'));
      allow list:   if isAdmin() || pageOn('users') || pageOn('supervisor');
      allow create: if isAdmin() || hasFeat('users', 'create');
      allow update: if isAdmin() || hasFeat('users', 'edit');
      allow delete: if isAdmin() || hasFeat('users', 'delete');
    }

    // ── الأدوار المخصصة ────────────────────────────────────────
    // الكتابة للمدير أو دور مُنح صراحةً «إدارة الأدوار والصلاحيات»
    match /custom_roles/{roleId} {
      allow read:  if signedIn();
      allow write: if isAdmin() || hasFeat('settings', 'roles');
    }

    // ── الحفلات ────────────────────────────────────────────────
    match /concerts/{concertId} {
      allow get: if isAdmin() || isWarehouse() || isKitchen() || pageOn('concerts') || pageOn('kitchen') ||
        pageOn('supervisor') || pageOn('employees') || pageOn('requests') || pageOn('warehouse_orders') ||
        (isSupervisor() && uid() in resource.data.supervisorIds) ||
        (isEmployee()   && uid() in resource.data.employeeIds);
      allow list: if isAdmin() || isWarehouse() || pageOn('concerts') ||
        pageOn('supervisor') || pageOn('employees') || pageOn('requests') ||
        (isSupervisor() && uid() in resource.data.supervisorIds) ||
        (isEmployee()   && uid() in resource.data.employeeIds);
      allow create: if isAdmin() || hasFeat('concerts', 'create');
      allow update: if isAdmin() ||
        hasFeat('concerts', 'edit') || hasFeat('concerts', 'assign') ||
        hasFeat('concerts', 'payments') || hasFeat('concerts', 'cancel') ||
        hasFeat('supervisor', 'receive_materials') || hasFeat('supervisor', 'set_location') ||
        hasFeat('supervisor', 'start_executing') || hasFeat('supervisor', 'return_materials') ||
        hasFeat('supervisor', 'deliver_warehouse') || hasFeat('supervisor', 'assign_employees') ||
        hasFeat('supervisor', 'request_materials') || hasFeat('requests', 'confirm_return') ||
        (isSupervisor() && uid() in resource.data.supervisorIds);
      allow delete: if isAdmin() || hasFeat('concerts', 'delete');
    }

    // ── مواد الحفلات ───────────────────────────────────────────
    // الموظف يقرأ فقط (مشاهدة المسند إليه) — لا يعدّل شيئاً
    match /concert_items/{itemId} {
      allow read:   if isAdmin() || isWarehouse() || isSupervisor() || isEmployee() || isKitchen() ||
        pageOn('concerts') || pageOn('kitchen') || pageOn('supervisor') || pageOn('employees') || pageOn('warehouse_orders');
      allow create: if isAdmin() || isSupervisor() || hasFeat('concerts', 'materials') || hasFeat('requests', 'approve');
      allow update: if isAdmin() || isSupervisor() || hasFeat('concerts', 'materials') ||
        hasFeat('supervisor', 'report_missing') || hasFeat('requests', 'approve');
      allow delete: if isAdmin() || isSupervisor() || hasFeat('concerts', 'materials');
    }

    // ── دفعات الحفلات (بيانات مالية) ───────────────────────────
    match /concert_payments/{paymentId} {
      allow read:  if isAdmin() || pageOn('concerts') || pageOn('finances');
      allow write: if isAdmin() || hasFeat('concerts', 'payments');
    }

    // ── سجلات الحفلات (Audit Log — لا يُحذف ولا يُعدَّل) ────────
    match /concert_logs/{logId} {
      allow read:           if isAdmin() || isSupervisor() || pageOn('concerts');
      allow create:         if signedIn();
      allow update, delete: if false;
    }

    // ── أكل الحفلات ────────────────────────────────────────────
    match /concert_food/{foodId} {
      allow read:                   if isAdmin() || isSupervisor() || isEmployee() || isKitchen() ||
        pageOn('concerts') || pageOn('kitchen') || pageOn('supervisor') || pageOn('employees');
      allow create, update, delete: if isAdmin() || isSupervisor() || hasFeat('concerts', 'food_items');
    }

    // ── أقسام الأكل ────────────────────────────────────────────
    match /food_categories/{catId} {
      allow read:  if signedIn();
      allow write: if isAdmin() ||
        hasFeat('food', 'add') || hasFeat('food', 'edit') ||
        hasFeat('food', 'delete') || hasFeat('food', 'reorder');
    }

    // ── مواد المخزن ────────────────────────────────────────────
    // ملاحظة: إضافة مواد لحفلة تُحدِّث الكمية المتاحة، لذا صلاحية
    // «إدارة مواد الحفلة» تسمح أيضاً بتحديث المخزون
    match /warehouse_items/{itemId} {
      allow read:  if signedIn();
      allow write: if isAdminOrWarehouse() ||
        hasFeat('warehouse', 'add') || hasFeat('warehouse', 'edit') || hasFeat('warehouse', 'delete') ||
        hasFeat('concerts', 'materials') ||
        hasFeat('requests', 'approve') || hasFeat('requests', 'confirm_return');
    }

    // ── طلبات المخزن ───────────────────────────────────────────
    match /warehouse_requests/{reqId} {
      allow read: if isAdmin() || isWarehouse() || pageOn('concerts') || pageOn('requests') || pageOn('supervisor') ||
        (isSupervisor() && resource.data.supervisorId == uid());
      allow create: if isAdmin() || hasFeat('concerts', 'materials') || hasFeat('supervisor', 'request_materials') ||
        (isSupervisor() && request.resource.data.supervisorId == uid());
      allow update: if isAdminOrWarehouse() || hasFeat('concerts', 'materials') ||
        hasFeat('requests', 'approve') || hasFeat('requests', 'reject');
      allow delete: if isAdmin();
    }

    // ── المفقودات ──────────────────────────────────────────────
    // التعديل والحذف للمدير فقط (أو دور مخصص منحه المدير هذه الصلاحية)
    match /missing_items/{itemId} {
      allow read:           if isAdmin() || isWarehouse() || isSupervisor() || pageOn('missing_items') || pageOn('concerts');
      allow create:         if signedIn();
      allow update, delete: if isAdmin() || hasFeat('missing_items', 'resolve');
    }

    // ── طلبات المطبخ ───────────────────────────────────────────
    match /kitchen_orders/{orderId} {
      allow read:   if isAdmin() || isKitchen() || pageOn('kitchen') || pageOn('concerts');
      allow create: if isAdmin() || hasFeat('concerts', 'send_kitchen');
      allow update: if isAdmin() || isKitchen() || hasFeat('kitchen', 'confirm') || hasFeat('concerts', 'send_kitchen');
      allow delete: if isAdmin();
    }

    // ── طلبات المخزن للحفلات (نسخة المخزن من طلب المطبخ) ──────
    match /warehouse_orders/{orderId} {
      allow read:   if isAdmin() || isWarehouse() || pageOn('concerts') || pageOn('warehouse_orders');
      allow create: if isAdmin() || hasFeat('concerts', 'send_kitchen');
      allow update: if isAdmin() || isWarehouse() || hasFeat('concerts', 'send_kitchen') ||
        hasFeat('warehouse_orders', 'confirm');
      allow delete: if isAdmin();
    }

    // ── العدادات (ترقيم الحفلات تسلسلياً، وباركود التكاليف) ────
    match /counters/{counterId} {
      allow read, write: if isAdmin() || hasFeat('concerts', 'create') || hasFeat('costs', 'manage_items');
    }

    // ── الإعدادات العامة (نسبة الضريبة…) ─────────────────────
    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin() || hasFeat('settings', 'vat') || hasFeat('finances', 'vat');
    }

    // ── التكاليف (خامات الإنتاج بالباركود) ────────────────────
    match /cost_items/{barcode} {
      allow read:   if signedIn();
      allow create: if isAdmin() || hasFeat('costs', 'manage_items') || hasFeat('costs', 'record_incoming');
      allow update: if isAdmin() || hasFeat('costs', 'manage_items') ||
        hasFeat('costs', 'record_incoming') || hasFeat('costs', 'record_outgoing');
      allow delete: if isAdmin() || hasFeat('costs', 'manage_items');
    }

    match /cost_incoming/{entryId} {
      allow read:           if isAdmin() || pageOn('costs');
      allow create:         if isAdmin() || hasFeat('costs', 'record_incoming');
      allow update, delete: if isAdmin();
    }

    match /cost_outgoing/{entryId} {
      allow read:           if isAdmin() || pageOn('costs') || pageOn('concerts');
      allow create:         if isAdmin() || hasFeat('costs', 'record_outgoing');
      allow update, delete: if isAdmin();
    }

    match /cost_settings/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin() || hasFeat('costs', 'manage_items');
    }

    // ── رفض كل ما عدا ما ذُكر ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
