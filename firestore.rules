rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال مساعدة ────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function role() {
      return userData().role;
    }

    function isAdmin()            { return signedIn() && role() == 'admin'; }
    function isWarehouse()        { return signedIn() && role() == 'warehouse_manager'; }
    function isSupervisor()       { return signedIn() && role() == 'supervisor'; }
    function isEmployee()         { return signedIn() && role() == 'employee'; }
    function isKitchen()          { return signedIn() && role() == 'kitchen'; }
    function isAdminOrWarehouse() { return signedIn() && role() in ['admin', 'warehouse_manager']; }

    // ── الأدوار المخصصة (صلاحيات على مستوى الميزات) ───────────
    function isCustom() { return signedIn() && role() == 'custom'; }

    function customPerms() {
      return get(/databases/$(database)/documents/custom_roles/$(userData().customRoleId)).data.permissions;
    }

    // الصفحة مفعّلة (عرض على الأقل)
    function pageOn(page) {
      return isCustom() && page in customPerms();
    }

    // يملك ميزة محددة داخل الصفحة — يدعم الصيغة القديمة 'manage'
    function hasFeat(page, feature) {
      return isCustom() && page in customPerms() && (
        customPerms()[page] is list
          ? feature in customPerms()[page]
          : customPerms()[page] == 'manage'
      );
    }

    // ── المستخدمون ─────────────────────────────────────────────
    match /users/{userId} {
      allow get:    if signedIn() && (uid() == userId || isAdmin() || pageOn('users') || pageOn('concerts') || pageOn('supervisor'));
      allow list:   if isAdmin() || pageOn('users') || pageOn('supervisor');
      allow create: if isAdmin() || hasFeat('users', 'create');
      allow update: if isAdmin() || hasFeat('users', 'edit');
      allow delete: if isAdmin() || hasFeat('users', 'delete');
    }

    // ── الأدوار المخصصة ────────────────────────────────────────
    // الكتابة للمدير أو دور مُنح صراحةً «إدارة الأدوار والصلاحيات»
    match /custom_roles/{roleId} {
      allow read:  if signedIn();
      allow write: if isAdmin() || hasFeat('users', 'roles_create')
                             || hasFeat('users', 'roles_edit')
                             || hasFeat('users', 'roles_delete');
    }

    // ── الحفلات ────────────────────────────────────────────────
    match /concerts/{concertId} {
      // النطاق هنا هو نطاق الواجهة نفسه: من مُنح «view_all» يقرأ الكل،
      // ومن دونه لا يقرأ إلا حفلاته. كان مجرّد امتلاك صفحة المشرف أو
      // صفحة المهام يفتح كل الحفلات، فيتجاوز التصفية التي تعرضها الشاشة.
      allow get: if isAdmin() || isWarehouse() || isKitchen() || pageOn('concerts') || pageOn('kitchen') || pageOn('profitability') ||
        pageOn('warehouse_orders') ||
        hasFeat('supervisor', 'view_all') || hasFeat('employees', 'view_all') ||
        (pageOn('supervisor') && uid() in resource.data.supervisorIds) ||
        (pageOn('employees')  && uid() in resource.data.employeeIds) ||
        (isSupervisor() && uid() in resource.data.supervisorIds) ||
        (isEmployee()   && uid() in resource.data.employeeIds);
      // list قاعدة مستقلة عن get ولا غنى عنها: كل قائمة حفلات في البرنامج
      // تمرّ منها. حُذفت سهواً عند نقل الكتابة للخادم فتعطّلت لوحة التحكم.
      allow list: if isAdmin() || isWarehouse() || pageOn('concerts') || pageOn('profitability') ||
        pageOn('warehouse_orders') ||
        hasFeat('supervisor', 'view_all') || hasFeat('employees', 'view_all') ||
        (pageOn('supervisor') && uid() in resource.data.supervisorIds) ||
        (pageOn('employees')  && uid() in resource.data.employeeIds) ||
        (isSupervisor() && uid() in resource.data.supervisorIds) ||
        (isEmployee()   && uid() in resource.data.employeeIds);
      // الكتابة من الخادم وحده (Admin SDK يتجاوز القواعد) — القواعد
      // تحرس المستند ولا تعرف قواعد الحجز والاشتقاق
      allow write: if false;
    }

    // ── مواد الحفلات ───────────────────────────────────────────
    // الموظف يقرأ فقط (مشاهدة المسند إليه) — لا يعدّل شيئاً
    match /concert_items/{itemId} {
      allow read:   if isAdmin() || isWarehouse() || isSupervisor() || isEmployee() || isKitchen() ||
        pageOn('concerts') || pageOn('kitchen') || pageOn('supervisor') || pageOn('employees') || pageOn('warehouse_orders');
      // الكتابة من الخادم وحده (Admin SDK يتجاوز القواعد) — القواعد
      // تحرس المستند ولا تعرف قواعد الحجز والاشتقاق
      allow write: if false;
    }

    // ── دفعات الحفلات (بيانات مالية) ───────────────────────────
    /* الدفعات تُكتب من الخادم (app/api/payments) وحده: المدفوع يُشتقّ من
       مجموعها، ورقم الفاتورة يُفحص تكراره قبل الكتابة — وكلاهما لا
       تستطيع القاعدة فرضه. */
    match /concert_payments/{paymentId} {
      allow read:  if isAdmin() || pageOn('concerts') || pageOn('finances');
      allow write: if false;
    }

    // ── سجلات الحفلات (Audit Log — لا يُحذف ولا يُعدَّل) ────────
    match /concert_logs/{logId} {
      allow read:           if isAdmin() || isSupervisor() || pageOn('concerts');
      // يُكتب من الخادم بهوية المستخدم الحقيقية لا بما يرسله
      allow create:         if false;
      allow update, delete: if false;
    }

    // ── أكل الحفلات ────────────────────────────────────────────
    match /concert_food/{foodId} {
      allow read:                   if isAdmin() || isSupervisor() || isEmployee() || isKitchen() ||
        pageOn('concerts') || pageOn('kitchen') || pageOn('supervisor') || pageOn('employees');
      // الكتابة من الخادم وحده (Admin SDK يتجاوز القواعد) — القواعد
      // تحرس المستند ولا تعرف قواعد الحجز والاشتقاق
      allow write: if false;
    }

    // ── أقسام الأكل ────────────────────────────────────────────
    // أقسام الأكل القديمة — حلّت محلّها منتجات البيع (sales_sections).
    // تبقى مقروءة لأن حفلات قديمة تشير إليها، ولا تُكتب بعد اليوم.
    match /food_categories/{catId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ── مواد الموارد ────────────────────────────────────────────
    // ملاحظة: إضافة مواد لحفلة تُحدِّث الكمية المتاحة، لذا صلاحية
    // «إدارة مواد الحفلة» تسمح أيضاً بتحديث المخزون
    match /warehouse_items/{itemId} {
      allow read:  if signedIn();
      // المتاح والمحجوز يتحرّكان مع مواد الحفلات في معاملة واحدة على
      // الخادم — كتابة مباشرة من المتصفح تكسر الحجز
      allow write: if false;
    }

    // ── المفقودات ──────────────────────────────────────────────
    // التعديل والحذف للمدير فقط (أو دور مخصص منحه المدير هذه الصلاحية)
    match /missing_items/{itemId} {
      allow read:           if isAdmin() || isWarehouse() || isSupervisor() || pageOn('missing_items') || pageOn('concerts');
      // الإنشاء من الخادم (يتحقّق أن المفقود لا يتجاوز ما أُخذ للحفلة)
      allow create:         if false;
      allow update, delete: if isAdmin() || hasFeat('missing_items', 'resolve');
    }

    // ── طلبات المطبخ ───────────────────────────────────────────
    match /kitchen_orders/{orderId} {
      allow read:   if isAdmin() || isKitchen() || pageOn('kitchen') || pageOn('concerts');
allow write: if false; // الإرسال والتأكيد من الخادم وحده
    }

    // ── طلبات الموارد للحفلات (نسخة الموارد من طلب المطبخ) ──────
    match /warehouse_orders/{orderId} {
      allow read:   if isAdmin() || isWarehouse() || pageOn('concerts') || pageOn('warehouse_orders');
allow write: if false; // الإرسال والتأكيد من الخادم وحده
    }

    /* التعاقدات ودفعاتها: تُقرأ بصلاحية الصفحة، وتُكتب من الخادم الذي
       يبني بنودها من التكاليف ويشتقّ المدفوع من دفعاتها. */
    match /contracts/{contractId} {
      allow read:  if isAdmin() || pageOn('contracts') || pageOn('profitability');
      allow write: if false;
    }

    match /contract_payments/{paymentId} {
      allow read:  if isAdmin() || pageOn('contracts') || pageOn('finances');
      allow write: if false;
    }

    /* الجدول اليومي: كل أرقامه مشتقّة على الخادم من ثلاثة مُدخَلات،
       وكتابته تحرّك المخزون — فلا تُكتب من المتصفح بحال. */
    match /contract_days/{dayId} {
      allow read:  if isAdmin() || hasFeat('contracts', 'ledger_view');
      allow write: if false;
    }

    /* هيكل منتجات البيع والبكجات: يقرؤه الجميع لبناء القوائم،
       والكتابة من الخادم وحده (يتحقّق أن الصنف مسجّل والقسم موجود). */
    match /sales_sections/{sectionId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    match /packages/{packageId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    /* مفاتيح روابط التصدير: يُنشئها ويقرؤها الخادم وحده. المفتاح مخزَّن
       مُجزّأً، وقراءته من المتصفح لا تفيد أحداً — فتُمنع كلياً. */
    match /export_keys/{keyId} {
      allow read, write: if false;
    }

    // ── العدادات (ترقيم الحفلات تسلسلياً، وباركود التكاليف) ────
    match /counters/{counterId} {
      allow read, write: if isAdmin() || hasFeat('concerts', 'create')
                             || hasFeat('contracts', 'create') || hasFeat('costs', 'item_config');
    }

    // ── الإعدادات العامة (نسبة الضريبة…) ─────────────────────
    match /settings/{docId} {
      allow read:  if signedIn();
      // المدير يضبط كل شيء؛ ومن مُنح صلاحية الضريبة يعدّل نسبتها وحدها —
      // إيقاف الميزات وتغيير المسمّيات قرار يخصّ النظام كله لا صفحةً منه
      // لكل مفتاح صلاحيته: من يملك الضريبة يعدّل vatRate وحده، ومن يملك
      // الميزات يعدّل features وحدها — فلا تُمنح صلاحية من الواجهة وتمنعها
      // القواعد بصمت، ولا يفتح مفتاحٌ واحد كل الإعدادات
      allow write: if isAdmin() || (
        resource == null ? false :
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(
            (hasFeat('settings', 'vat')      ? ['vatRate']     : [])
              .concat(hasFeat('settings', 'features') ? ['features']    : [])
              .concat(hasFeat('settings', 'labels')   ? ['labels']      : [])
              .concat(hasFeat('settings', 'idle')     ? ['idleMonths']  : [])
          )
      );
    }

    /* ── التكاليف — قراءة فقط من المتصفح ────────────────────────
       كل كتابة تمرّ من الخادم (app/api/costs/*) الذي يتحقّق من الهوية
       والصلاحية ثم يحسب الأرصدة والقيم بنفسه. القاعدة تحرس المستند ولا
       تعرف أن totalIn يجب أن يزيد بمقدار الوارد بالضبط — فمن يملك بيانات
       الدخول كان يستطيع كتابة أي رقم. المنع هنا يغلق ذلك نهائياً، و
       Admin SDK يتجاوز القواعد فلا يتأثر الخادم.                     */

    match /cost_items/{barcode} {
      allow read:  if signedIn();
      allow write: if false;
    }

    match /cost_incoming/{entryId} {
      allow read:  if isAdmin() || pageOn('costs');
      allow write: if false;
    }

    // الإنتاج (الخلطات) — يستهلك خاماً ويُنتج صنفاً جاهزاً بتكلفة مدخلاته
    match /cost_production/{entryId} {
      allow read:  if isAdmin() || pageOn('costs') || pageOn('profitability');
      allow write: if false;
    }

    match /dispense_requests/{docId} {
      allow read:  if isAdmin() || hasFeat('costs', 'req_view') || hasFeat('costs', 'req_approve');
      allow write: if false; // الإقرار والمزامنة من الخادم وحده
    }

    match /cost_outgoing/{entryId} {
      allow read:  if isAdmin() || pageOn('costs') || pageOn('concerts') || pageOn('profitability');
      allow write: if false;
    }

    match /cost_damage/{entryId} {
      allow read:  if isAdmin() || pageOn('costs') || pageOn('profitability');
      allow write: if false;
    }

    match /cost_settings/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin() || hasFeat('costs', 'item_config');
    }

    // ── فواتير مصروفات الحفلة ─────────────────────────────────
    // تُقرأ من صفحة الحفلة والقائمة المالية وصفحة الربحية
    match /concert_expenses/{expenseId} {
      allow read:   if isAdmin() || pageOn('concerts') || pageOn('finances') || pageOn('profitability');
      // الكتابة من الخادم: يتحقّق من حالة الحفلة ويعيد حساب تكاليفها
      allow write: if false;
    }

    match /expense_settings/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin() || hasFeat('concerts', 'exp_add');
    }

    // ── رفض كل ما عدا ما ذُكر ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
